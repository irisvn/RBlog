APP_NAME="rblog"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
# Generate with: rustcms key:generate
APP_KEY=

# MySQL 8.4 only (docker compose up -d --wait). Create the database with `CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_bin`.
DATABASE_URL=mysql://rblog:rblog@localhost:3306/rblog
